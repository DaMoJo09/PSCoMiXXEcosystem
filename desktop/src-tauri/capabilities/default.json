{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for the main PSCoMiXX desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "os:allow-arch",
    "os:allow-locale",
    "process:allow-restart",
    "process:allow-exit",
    "updater:default"
  ]
}
