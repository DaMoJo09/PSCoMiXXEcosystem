{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PSCoMiXX",
  "version": "0.1.0",
  "identifier": "com.pscomixx.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://pscomixx.com",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PSCoMiXX",
        "url": "https://pscomixx.com",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "category": "Graphics",
    "shortDescription": "PSCoMiXX creative studio",
    "longDescription": "Create comics, cards, motion art, visual novels, and more with the PSCoMiXX creative studio. Build your portfolio, stream to an audience, earn XP, and get certified.",
    "copyright": "Copyright © 2026 Press Start CoMiXX. All rights reserved.",
    "publisher": "Press Start CoMiXX",
    "homepage": "https://pscomixx.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "entitlements": null,
      "exceptionDomain": "pscomixx.com"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/damojo09/pscomixx-desktop/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY"
    }
  }
}
